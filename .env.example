# Copy to .env for local runs. In GitHub Actions these come from repository Secrets —
# never commit real values.

# Required: POV generation, scoring, and all gate/classification calls.
ANTHROPIC_API_KEY=

# Required: sending the digest.
RESEND_API_KEY=
RESEND_FROM=raunak.srivastava@tadanow.com

# Required for the LinkedIn section. Without it that section is simply empty.
LINKDAPI_API_KEY=

# Unused. Kept because brave_search.py still works if a paid key is ever added; the
# competitor section runs on Google News RSS, which needs no key.
BRAVE_API_KEY=
