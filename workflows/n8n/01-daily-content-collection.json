      "id": "rss-industry-week",
      "name": "RSS: IndustryWeek",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [340, 900],
      "continueOnFail": true
    },
    {
      "parameters": {
        "url": "https://www.thomasnet.com/insights/feed/",
        "responseFormat": "string",
        "options": { "timeout": 10000 }
      },
      "id": "rss-thomas-net",
      "name": "RSS: ThomasNet",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [340, 1000],
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "// Parse all RSS feeds and merge into unified article list\nconst items = [];\n\nfor (const input of $input.all()) {\n  try {\n    const feedData = input.json.data;\n    const sourceName = input.json.source || 'Unknown';\n    \n    // Simple XML parsing for RSS items\n    const itemMatches = feedData.matchAll(/<item>([\\s\\S]*?)<\\/item>/g);\n    \n    for (const match of itemMatches) {\n      const itemXml = match[1];\n      \n      const titleMatch = itemXml.match(/<title><!\\[CDATA\\[([\\s\\S]*?)\\]\\]><\\/title>/) || \n                         itemXml.match(/<title>([\\s\\S]*?)<\\/title>/);\n      const linkMatch = itemXml.match(/<link>([\\s\\S]*?)<\\/link>/);\n      const descMatch = itemXml.match(/<description><!\\[CDATA\\[([\\s\\S]*?)\\]\\]><\\/description>/) ||\n                        itemXml.match(/<description>([\\s\\S]*?)<\\/description>/);\n      const pubDateMatch = itemXml.match(/<pubDate>([\\s\\S]*?)<\\/pubDate>/);\n      const guidMatch = itemXml.match(/<guid[^>]*>([\\s\\S]*?)<\\/guid>/);\n      \n      const title = titleMatch ? titleMatch[1].trim() : '';\n      const url = linkMatch ? linkMatch[1].trim() : '';\n      const description = descMatch ? descMatch[1].replace(/<[^>]+>/g, '').trim().substring(0, 500) : '';\n      const pubDate = pubDateMatch ? pubDateMatch[1].trim() : new Date().toISOString();\n      const guid = guidMatch ? guidMatch[1].trim() : url;\n      \n      if (title && url) {\n        // Generate content hash for deduplication\n        const hashInput = `${url}${title}`;\n        let hash = 0;\n        for (let i = 0; i < hashInput.length; i++) {\n          const char = hashInput.charCodeAt(i);\n          hash = ((hash << 5) - hash) + char;\n          hash = hash & hash;\n        }\n        const contentHash = Math.abs(hash).toString(16);\n        \n        items.push({\n          json: {\n            title,\n            url,\n            description,\n            pub_date: pubDate,\n            source_name: sourceName,\n            content_hash: contentHash,\n            guid,\n            raw_content: description,\n            collected_at: new Date().toISOString()\n          }\n        });\n      }\n    }\n  } catch (err) {\n    // Skip malformed feeds\n    console.log(`Error parsing feed: ${err.message}`);\n  }\n}\n\nreturn items;"
      },
      "id": "parse-rss-feeds",
      "name": "Parse RSS Feeds",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [600, 500]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT content_hash FROM raw_content WHERE content_hash = ANY(ARRAY[{{ $json.content_hashes }}]::text[]) AND collected_at > NOW() - INTERVAL '7 days'",
        "additionalFields": {}
      },
      "id": "check-duplicates",
      "name": "Check Existing Hashes (Batch)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [820, 500],
      "credentials": {
        "postgres": {
          "id": "postgres-tada",
          "name": "TADA PostgreSQL"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Extract hashes and prepare batch dedup query\nconst allItems = $input.all();\nconst hashes = allItems.map(item => item.json.content_hash);\n\n// Return single item with all hashes for batch check\nreturn [{\n  json: {\n    content_hashes: hashes.join(\"','\"),\n    items: allItems.map(i => i.json),\n    total_fetched: allItems.length\n  }\n}];"
      },
      "id": "prepare-batch-dedup",
      "name": "Prepare Batch Dedup",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [720, 500]
    },
    {
      "parameters": {
        "jsCode": "// Filter out items that already exist in DB\nconst existing = $input.all()[0].json;\nconst existingHashes = new Set(\n  (existing.rows || []).map(r => r.content_hash)\n);\n\n// Get original items from previous node\nconst allItems = $('Prepare Batch Dedup').first().json.items || [];\n\nconst newItems = allItems.filter(item => !existingHashes.has(item.content_hash));\n\nif (newItems.length === 0) {\n  return [{ json: { status: 'no_new_content', count: 0 } }];\n}\n\nreturn newItems.map(item => ({ json: item }));"
      },
      "id": "filter-duplicates",
      "name": "Filter New Content Only",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [920, 500]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "has-new-content",
              "leftValue": "={{ $json.status }}",
              "rightValue": "no_new_content",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "has-new-content-check",
      "name": "Has New Content?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1060, 500]
    },
